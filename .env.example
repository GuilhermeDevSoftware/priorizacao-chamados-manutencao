# Opcional: copie para .env local e preencha somente no seu computador.
# Nunca coloque a chave na interface, no GitHub Pages, no notebook ou no Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=5000
# SQLite e fotos ficam em instance/ no computador que executa o Flask.
# A integração de texto e imagem usa OPENAI_API_KEY somente no servidor.
# Sem chave ou sem serviço externo, o cadastro manual continua disponível.

# Opcional: pasta persistente que contém o SQLite e as fotos.
PRIORIZA_DATA_DIR=

# Gere uma credencial longa com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem credencial configurada, consultas e cadastros funcionam e alterações ficam bloqueadas.
PRIORIZA_ADMIN_TOKEN=
PRIORIZA_ADMIN_NOME="Responsável pela manutenção"

# Configure a mesma chave em todos os processos Flask para reaproveitar a análise antes de salvar.
# Se a chave estiver vazia, o processo gera uma chave aleatória ao iniciar.
PRIORIZA_CHAVE_ASSINATURA=
