# Opcional: copie para .env local e preencha somente no seu computador.
# Nunca coloque a chave na interface, no GitHub Pages, no notebook ou no Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=5000
# SQLite e fotos ficam em instance/ no computador que executa o Flask.
# A integração de texto e imagem usa OPENAI_API_KEY somente no servidor.
# Sem chave ou sem serviço externo, o cadastro manual continua disponível.
